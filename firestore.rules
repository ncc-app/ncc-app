rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isRole(roleStr) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        getUserData().role == roleStr;
    }

    function isAdmin() {
      return isRole('admin');
    }
    
    function isSuperAdmin() {
      return isRole('superadmin');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Allow owner to create their own record, or admins to create during approvals
      allow create: if isAuthenticated() && (request.auth.uid == userId || isAdmin() || isSuperAdmin());
      // Allow owner to update own profile, admins/superadmins can update credentials and role
      allow update: if isOwner(userId) || isAdmin() || isSuperAdmin();
      // Narrow role-only updates path (kept for clarity)
      allow update: if (isAdmin() || isSuperAdmin()) && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']);
      allow delete: if isSuperAdmin() || (isAdmin() && resource.data.role != 'superadmin');

      // User's read-announcements tracking (for unread count)
      match /readAnnouncements/{announcementId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update, delete: if false;
      }
    }

    // Public Registry for unique ID numbers (Regimental, Register, Roll)
    // Document ID is the number itself (e.g., 'TN20SDA123456')
    match /takenNumbers/{numberId} {
      // Anyone can read this collection to check for duplicates securely
      allow read: if true;
      // User can create/delete their own numbers, or Admins can manage them
      allow create, delete: if isAuthenticated() && (
        request.resource.data.uid == request.auth.uid || 
        resource.data.uid == request.auth.uid || 
        isAdmin() || 
        isSuperAdmin()
      );
      // Updates are not allowed; if a number changes, delete old and create new
      allow update: if false;
    }

    // Pending cadet registrations awaiting approval
    match /pendingCadets/{candidateId} {
      // Admins can read all, pending users can read their own record by UID or Email
      allow read: if isAdmin() || isSuperAdmin() || (isAuthenticated() && (resource.data.uid == request.auth.uid || resource.data.email == request.auth.token.email));
      // Allow unauthenticated users to create registration (write-once)
      allow create: if true;
      // Allow the pending user to update only their emailVerified field
      allow update: if isAuthenticated() && 
        resource.data.uid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emailVerified']);
      // Admins can update/delete
      allow update, delete: if isAdmin() || isSuperAdmin();
    }
    
    // Cadets collection
    match /cadets/{cadetId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isSuperAdmin();
    }
    
    // Events collection
    match /events/{eventId} {
      allow read: if true; // Public
      allow write: if isAdmin() || isSuperAdmin();
    }
    
    // Attendance sessions
    match /attendanceSessions/{sessionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isSuperAdmin();

      match /marks/{markId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin() || isSuperAdmin();
      }
    }

    // Cadet attendance statistics (computed per-user stats)
    match /cadetAttendanceStats/{cadetId} {
      // Users can read their own stats, admins can read all
      allow read: if isOwner(cadetId) || isAdmin() || isSuperAdmin();
      // Only admins can write (computed/updated by service)
      allow write: if isAdmin() || isSuperAdmin();
    }

    // Division definitions (optional, for future use)
    match /divisions/{divisionId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }
    
    // Duties
    match /duties/{dutyId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isSuperAdmin();
    }

    // Event Drives (opt-in/opt-out polling)
    match /eventDrives/{driveId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isSuperAdmin();

      // Responses subcollection — cadets write their own response only
      match /responses/{responseId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() && request.auth.uid == responseId;
        allow delete: if isAdmin() || isSuperAdmin();
      }
    }
    
    // Gallery
    match /gallery/{albumId} {
      allow read: if true; // Public
      allow write: if isAdmin() || isSuperAdmin();
      
      match /photos/{photoId} {
        allow read: if true;
        allow write: if isAdmin() || isSuperAdmin();
      }
    }
    
    // Alumni profiles (public directory + admin management)
    match /alumniProfiles/{profileId} {
      allow read: if resource.data.status == 'active' && resource.data.visible == true;
      allow read: if isSuperAdmin();
      allow create: if
        request.resource.data.status == 'pending' &&
        request.resource.data.visible == false &&
        request.resource.data.source == 'self_submit';
      allow create: if isSuperAdmin();
      allow update, delete: if isSuperAdmin();
    }

    // Alumni (legacy rollover tracking)
    match /alumni/{alumniId} {
      allow read: if true; // Public if opted in
      allow write: if isOwner(alumniId) || isSuperAdmin(); // Superadmins needed for rollover cleanup
    }
    
    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isSuperAdmin();
    }

    // Announcements — visibility-based read access
    match /announcements/{announcementId} {
      // Public announcements readable by anyone; auth_only by authenticated users
      allow read: if resource.data.visibility == 'public' || isAuthenticated();
      allow create: if isAdmin() || isSuperAdmin();
      allow update: if isAdmin() || isSuperAdmin();
      allow delete: if isAdmin() || isSuperAdmin();

      // Read tracking subcollection (who has read this announcement)
      match /reads/{userId} {
        allow read: if isAdmin() || isSuperAdmin();
        allow create: if isAuthenticated() && request.auth.uid == userId;
        allow update: if false;
        allow delete: if isAdmin() || isSuperAdmin();
      }
    }
    
    // Parade logs
    match /paradeLogs/{logId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isSuperAdmin();
    }
    
    // Achievements
    match /achievements/{achievementId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isSuperAdmin();
    }
    
    // Reports
    match /reports/{reportId} {
      allow read: if isAdmin() || isSuperAdmin();
      allow write: if isAdmin() || isSuperAdmin();
    }

    // Report templates (admin managed)
    match /reportTemplates/{templateId} {
      allow read, write: if isAdmin() || isSuperAdmin();
    }
    
    // CMS pages (About, Contact, Unit Structure, etc.)
    match /cms/{docId} {
      // Publicly readable content, only admins can write
      allow read: if true;
      allow write: if isAdmin() || isSuperAdmin();
    }
    
    // Audit logs
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isAdmin() || isSuperAdmin();
      allow update, delete: if false; // Immutable
    }

    // App settings (configurable by admins — rollover date, retention, etc.)
    // Recruitment settings need public read for the recruitment page
    match /settings/{docId} {
      allow read: if docId == 'recruitment' || isAdmin() || isSuperAdmin();
      allow write: if isAdmin() || isSuperAdmin();
    }

    // Pending auth deletions queue (written by admins, processed by automation)
    match /pendingAuthDeletions/{uid} {
      allow read: if isAdmin() || isSuperAdmin();
      allow create: if isAdmin() || isSuperAdmin();
      allow update: if false;
      allow delete: if isAdmin() || isSuperAdmin(); // Allowed for rollback
    }

    // Rollback snapshots (created by automation or admin rollover, read by admins)
    match /rollbackSnapshots/{snapshotId} {
      allow read: if isAdmin() || isSuperAdmin();
      allow create: if isAdmin() || isSuperAdmin();
      allow update, delete: if false; // Immutable snapshots
    }

    // Cloudinary Cleanup Queue (written by users/admins, processed by github actions)
    match /cloudinary_cleanup/{docId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin() || isSuperAdmin();
    }
  }
}
